# ── Firebase (콘솔 > 프로젝트 설정 > 내 앱 > 웹 앱 구성) ──
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.asia-southeast1.firebasedatabase.app
NEXT_PUBLIC_FIREBASE_APP_ID=

# 로컬 에뮬레이터로 돌릴 때만 1 (npm run emulators 와 함께)
NEXT_PUBLIC_USE_EMULATORS=0

# ── 구글 시트 (서버 전용, 선택) ──
# 서비스 계정 JSON 한 줄. 없으면 '링크가 있는 모든 사용자 보기' 시트만 읽힌다.
# ARON 의 GOOGLE_SERVICE_ACCOUNT_JSON 을 그대로 써도 된다 (시트를 서비스 계정 이메일에 공유).
GOOGLE_SERVICE_ACCOUNT_JSON=
# 쉼표로 구분한 허용 시트 ID. 비워두면 제한 없음.
ALLOWED_SHEET_IDS=
