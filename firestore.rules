rules_version = '2';

// Firestore: 캠페인·멤버·캐릭터
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function campaignPath(cid) { return /databases/$(database)/documents/campaigns/$(cid); }
    function isMember(cid) {
      return signedIn() && exists(/databases/$(database)/documents/campaigns/$(cid)/members/$(request.auth.uid));
    }
    function isGM(cid) { return signedIn() && get(campaignPath(cid)).data.gmUid == request.auth.uid; }

    // 내 캠페인 목록 (홈 화면)
    match /users/{uid}/campaigns/{cid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // 캐릭터 보관함 — 본인만
    match /users/{uid}/library/{id} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // 초대 코드 → 캠페인 ID. 코드를 아는 사람만 단건 조회 가능 (목록 조회 불가)
    match /inviteCodes/{code} {
      allow get: if signedIn();
      allow create: if signedIn()
        && getAfter(campaignPath(request.resource.data.cid)).data.gmUid == request.auth.uid;
      allow delete: if isGM(resource.data.cid);
    }

    match /campaigns/{cid} {
      allow read: if isMember(cid);
      allow create: if signedIn() && request.resource.data.gmUid == request.auth.uid;
      allow update: if isGM(cid) && request.resource.data.gmUid == resource.data.gmUid;
      allow delete: if isGM(cid);

      match /members/{uid} {
        allow read: if isMember(cid);
        // 플레이어: 초대 코드가 맞을 때만 자기 자신을 추가
        // GM: 캠페인을 만들 때 자기 자신을 추가
        allow create: if signedIn() && request.auth.uid == uid && (
          (request.resource.data.role == 'player'
            && request.resource.data.inviteCode == get(campaignPath(cid)).data.inviteCode)
          || (request.resource.data.role == 'gm'
            && getAfter(campaignPath(cid)).data.gmUid == request.auth.uid)
        );
        allow update: if isGM(cid)
          || (signedIn() && request.auth.uid == uid
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name']));
        allow delete: if isGM(cid) || (signedIn() && request.auth.uid == uid);
      }

      // 핸드아웃·저널 — 공개했거나, 나에게 보냈거나, 내가 쓴 것만 읽는다
      match /journal/{jid} {
        allow read: if isGM(cid) || (isMember(cid) && (
          resource.data.shared == true
          || request.auth.uid in resource.data.viewers
          || resource.data.ownerUid == request.auth.uid));
        allow create: if isMember(cid) && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.viewers is list && request.resource.data.shared is bool;
        allow update: if isGM(cid) || (isMember(cid) && resource.data.ownerUid == request.auth.uid
          && request.resource.data.ownerUid == request.auth.uid);
        allow delete: if isGM(cid) || (isMember(cid) && resource.data.ownerUid == request.auth.uid);
      }

      match /characters/{chid} {
        // 에너미는 GM 만 (플레이어에게는 HP·능력치가 아예 내려가지 않는다)
        allow read: if isGM(cid) || (isMember(cid) && resource.data.kind in ['pc', 'npc']);
        // 플레이어는 보관함에서 자기 PC 를 넣을 수 있다 (담당이 자기 자신인 PC 로만)
        allow create: if isGM(cid)
          || (isMember(cid) && request.resource.data.kind == 'pc' && request.resource.data.ownerUid == request.auth.uid);
        allow delete: if isGM(cid);
        // 플레이어는 자기 캐릭터의 HP·MP·페이트, 그림·색, 툴 안 시트(ar)만 바꿀 수 있다
        allow update: if isGM(cid)
          || (isMember(cid) && resource.data.ownerUid == request.auth.uid
              && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['hp', 'mp', 'fate', 'portrait', 'standing', 'token', 'color', 'ar']));
      }
    }
  }
}
