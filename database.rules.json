{
  "rules": {
    "gm": {
      "$cid": {
        ".read": "auth != null && root.child('members').child($cid).child(auth.uid).exists()",
        ".write": "auth != null && !data.exists() && newData.val() === auth.uid"
      }
    },
    "codes": {
      "$cid": {
        ".write": "auth != null && root.child('gm').child($cid).val() === auth.uid"
      }
    },
    "members": {
      "$cid": {
        ".read": "auth != null && data.child(auth.uid).exists()",
        "$uid": {
          ".write": "auth != null && ((auth.uid === $uid && !data.exists() && ((newData.child('role').val() === 'player' && newData.child('code').val() === root.child('codes').child($cid).val()) || (newData.child('role').val() === 'gm' && root.child('gm').child($cid).val() === auth.uid))) || (root.child('gm').child($cid).val() === auth.uid && !newData.exists()))"
        }
      }
    },
    "scene": {
      "$cid": {
        ".read": "auth != null && root.child('members').child($cid).child(auth.uid).exists()",
        ".write": "auth != null && root.child('gm').child($cid).val() === auth.uid"
      }
    },
    "fx": {
      "$cid": {
        ".read": "auth != null && root.child('members').child($cid).child(auth.uid).exists()",
        "cutin": {
          ".write": "auth != null && root.child('members').child($cid).child(auth.uid).exists()",
          ".validate": "newData.hasChildren(['key', 'at', 'uid']) && newData.child('uid').val() === auth.uid && newData.child('key').isString() && newData.child('key').val().length <= 64 && root.child('scene').child($cid).child('cutins').child(newData.child('key').val()).exists()"
        }
      }
    },
    "battle": {
      "$cid": {
        ".read": "auth != null && root.child('members').child($cid).child(auth.uid).exists()",
        "meta": {
          ".write": "auth != null && root.child('gm').child($cid).val() === auth.uid"
        },
        "tokens": {
          ".write": "auth != null && root.child('gm').child($cid).val() === auth.uid"
        },
        "pos": {
          ".write": "auth != null && root.child('gm').child($cid).val() === auth.uid",
          "$tid": {
            ".write": "auth != null && root.child('battle').child($cid).child('tokens').child($tid).child('ownerUid').val() === auth.uid",
            ".validate": "!newData.exists() || (newData.hasChildren(['x', 'y']) && newData.child('x').isNumber() && newData.child('y').isNumber())"
          }
        }
      }
    },
    "chat": {
      "$cid": {
        "public": {
          ".read": "auth != null && root.child('members').child($cid).child(auth.uid).exists()",
          "$mid": {
            ".write": "auth != null && root.child('members').child($cid).child(auth.uid).exists() && ((!data.exists() && newData.child('uid').val() === auth.uid) || (!newData.exists() && root.child('gm').child($cid).val() === auth.uid))",
            ".validate": "!newData.exists() || (newData.hasChildren(['ts', 'uid', 'kind', 'text', 'speaker']) && newData.child('text').isString() && newData.child('text').val().length <= 4000)"
          }
        },
        "inbox": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid && root.child('members').child($cid).child(auth.uid).exists()",
            "$mid": {
              ".write": "auth != null && root.child('members').child($cid).child(auth.uid).exists() && root.child('members').child($cid).child($uid).exists() && !data.exists() && newData.child('uid').val() === auth.uid",
              ".validate": "newData.hasChildren(['ts', 'uid', 'kind', 'text', 'speaker']) && newData.child('text').isString() && newData.child('text').val().length <= 4000"
            }
          }
        }
      }
    }
  }
}
